.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.hero {
  padding: 50rpx 32rpx 40rpx;
  text-align: center;
  background: linear-gradient(170deg, #E8EEFF, #F7F8FC);
  border-radius: 0 0 40rpx 40rpx;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto;
  line-height: 130rpx;
  text-align: center;
  font-size: 64rpx;
  background: #FFFFFF;
  border-radius: 38rpx;
  box-shadow: 0 12rpx 28rpx rgba(94, 110, 168, 0.09);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 38rpx;
}

.shop-name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.slogan {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8C93AB;
}

.tags {
  margin-top: 24rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  margin: 0 8rpx;
  font-size: 21rpx;
  color: #5B7BE0;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 100rpx;
}

.card {
  margin: 24rpx 32rpx 0;
  padding: 30rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(94, 110, 168, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.body-text {
  font-size: 26rpx;
  line-height: 1.85;
  color: #6B7189;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  margin-right: 18rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(140deg, #9BB6FF, #6C8FF0);
  border-radius: 50%;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4B5169;
}

.contact {
  background: linear-gradient(150deg, #EEF2FF, #EDF2FF);
  box-shadow: none;
}

.contact-label {
  font-size: 23rpx;
  color: #9BA2B8;
}

.contact-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #5A7CE0;
}

.contact-tip {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #A2A9BF;
}

.go {
  margin: 40rpx 32rpx 0;
}

.foot {
  margin: 30rpx 52rpx 0;
  font-size: 20rpx;
  line-height: 1.7;
  text-align: center;
  color: #B6BCCD;
}

/* ---------- 封面图模式 ---------- */
.hero-cover {
  position: relative;
  overflow: hidden;
  min-height: 700rpx;
  padding-top: 0;
  display: flex;
  align-items: flex-end;
  background: none;
  border-radius: 0;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-veil {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(247, 248, 252, 0) 0%,
    rgba(247, 248, 252, 0.08) 42%,
    rgba(247, 248, 252, 0.38) 72%,
    rgba(247, 248, 252, 0.58) 100%
  );
}

.hero-cover .hero-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 40rpx 32rpx 46rpx;
}

.hero-cover .shop-name,
.hero-cover .slogan {
  text-shadow: 0 2rpx 14rpx rgba(255, 255, 255, 1), 0 0 26rpx rgba(255, 255, 255, 0.92);
}
