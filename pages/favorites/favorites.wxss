.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.head {
  padding: 32rpx 32rpx 18rpx;
  font-size: 24rpx;
  color: #A2A9BF;
}

.list {
  padding: 0 32rpx;
}

.card {
  display: flex;
  padding: 22rpx;
  margin-bottom: 22rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(94, 110, 168, 0.06);
}

.thumb {
  width: 150rpx;
  height: 150rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
}

.thumb-emoji {
  font-size: 68rpx;
  line-height: 1;
}

.card-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
}

.card-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #98A0B8;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 14rpx;
}

.btns {
  display: flex;
  align-items: center;
}

.mini {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(140deg, #8FAEFF, #6C8FF0);
  border-radius: 100rpx;
}

.mini.ghost {
  color: #7E8599;
  background: #FFFFFF;
  border: 2rpx solid #E8EBF4;
  margin-right: 14rpx;
}

.empty-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}
