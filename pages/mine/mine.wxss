.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.profile {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 32rpx 28rpx;
  background: linear-gradient(150deg, #E8EEFF, #EEF2FF);
  border-radius: 30rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  flex: none;
  line-height: 100rpx;
  text-align: center;
  font-size: 50rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(94, 110, 168, 0.09);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
}

.profile-main {
  margin-left: 22rpx;
  min-width: 0;
}

.shop-name {
  font-size: 38rpx;
  font-weight: 800;
}

.slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C93AB;
}

.stats {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 26rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(94, 110, 168, 0.06);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #5A7CE0;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A2A9BF;
}

.stat-divider {
  width: 2rpx;
  height: 44rpx;
  background: rgba(108, 143, 240, 0.14);
}

.group {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 22rpx rgba(94, 110, 168, 0.05);
}

.group-title {
  padding: 24rpx 26rpx 6rpx;
  font-size: 23rpx;
  color: #A2A9BF;
}

.cell {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 28rpx 26rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F0F2F9;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: left;
}

.cell:last-child {
  border-bottom: none;
}

.cell-btn {
  margin: 0;
}

.cell-btn::after {
  border: none;
}

.cell-icon {
  width: 44rpx;
  font-size: 28rpx;
}

.cell-title {
  flex: 1;
  font-size: 28rpx;
  color: #383D52;
}

.cell-value {
  font-size: 25rpx;
  color: #A2A9BF;
  margin-right: 10rpx;
}

.cell-arrow {
  font-size: 32rpx;
  color: #C6CBDA;
}

.server {
  padding: 20rpx 26rpx 28rpx;
}

.server-input {
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  background: #F5F7FD;
  border-radius: 18rpx;
}

.server-ph {
  color: #B9BFD0;
}

.server-actions {
  display: flex;
  margin-top: 18rpx;
}

.mini-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(140deg, #8FAEFF, #6C8FF0);
  border-radius: 100rpx;
}

.mini-btn.ghost {
  color: #4B5169;
  background: #FFFFFF;
  border: 2rpx solid #E8EBF4;
  margin-left: 18rpx;
}

.server-hint {
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #A2A9BF;
}

.foot {
  margin: 40rpx 52rpx 0;
  font-size: 20rpx;
  line-height: 1.7;
  text-align: center;
  color: #B6BCCD;
}
